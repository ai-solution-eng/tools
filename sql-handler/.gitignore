# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Environment / secrets — NEVER commit real credentials
config/.env
.env
.env.*
!.env.example
*.env.local
# Deploy values with embedded credentials: any per-site values file
helm/deploy-*-values.yaml
# Local-only deployment values (helm/local/README.md explains the convention)
helm/local/*
!helm/local/README.md
!helm/local/values.example.yaml

# OS/editor
.DS_Store
# Local dev tooling (MinIO binary + test data + scratch scripts)
.dev/
# Generated test parquet datasets (large, not for VCS)
data/*.parquet
data/**/*.parquet
# Local build artifacts (packaged chart / wheel archives)
/*.tar.gz
*.tgz
