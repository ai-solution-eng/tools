# SQLhandler environment configuration.
#
# Copy this file to `config/.env` and fill in the Toromont Fabric service
# principal + lakehouse coordinates. DO NOT commit the real secret.
#
# The temporary service principal provided by Toromont:
#   ClientId   = b0fa0023-7302-455b-aec0-e39f003e254c
#   Secret     = <set in .env only>
#   Tenant     = b00a53e9-3e50-4a49-bdc5-dcc689fcf301
#   Lakehouse  = lh_ai_workorder (workspace "TORS Product Support")
#   ABFS       = abfss://8168bc71-054c-4b2a-82d0-6953b05a6ae7@onelake.dfs.fabric.microsoft.com/08317ae7-0c9f-43d3-a20c-266cf2f1f233/Tables

# --- Microsoft Entra ID service principal (required) ---
FABRIC_TENANT_ID=b00a53e9-3e50-4a49-bdc5-dcc689fcf301
FABRIC_CLIENT_ID=b0fa0023-7302-455b-aec0-e39f003e254c
FABRIC_CLIENT_SECRET=CHANGE_ME

# --- Lakehouse coordinates (use EITHER the full URL or the two IDs) ---
# Full ABFS URL to the lakehouse (preferred)
FABRIC_LAKEHOUSE_ABFSS_URL=abfss://8168bc71-054c-4b2a-82d0-6953b05a6ae7@onelake.dfs.fabric.microsoft.com/08317ae7-0c9f-43d3-a20c-266cf2f1f233
# ...or the two GUIDs it is derived from:
FABRIC_WORKSPACE_ID=8168bc71-054c-4b2a-82d0-6953b05a6ae7
FABRIC_LAKEHOUSE_ID=08317ae7-0c9f-43d3-a20c-266cf2f1f233

# Optional override (defaults to the public OneLake authority)
FABRIC_AUTHORITY=onelake.dfs.fabric.microsoft.com

# --- In-process caching (optional) ---
# How long list_tables / describe_table results stay cached in memory (seconds; 0 disables).
SQLHANDLER_CACHE_TTL=3600
# Comma-separated Delta table names whose schemas are warmed into the describe cache at
# startup — the tables your queries hit most often (e.g. work_order_header,work_order_note_recent).
SQLHANDLER_PREWARM_TABLES=
# Reuse open Delta datasets per table (0 disables; keeps the Delta _delta_log from being
# re-read on every query). Default 3600; LRU cap SQLHANDLER_DATASET_CACHE_TABLES (default 8).
SQLHANDLER_DATASET_CACHE_TTL=3600
SQLHANDLER_DATASET_CACHE_TABLES=8
# ---------------------------------------------------------------------------
# Backend: onelake (default) or s3/minio
# ---------------------------------------------------------------------------
# Pick the data source. 'onelake' reads Microsoft OneLake (Delta Lake);
# 's3' / 'minio' reads Parquet files from an S3-compatible object store.
SQLHANDLER_BACKEND=onelake

# --- S3-compatible backend (only used when SQLHANDLER_BACKEND=s3) ---
# Endpoint URL; for a local MinIO:
#   S3_ENDPOINT_URL=http://127.0.0.1:9000
# (scheme optional; https is used when S3_USE_SSL=true)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME
# S3_SESSION_TOKEN=
# Bucket + optional prefix that acts as the tables root. Tables are
# discovered under it as Parquet files/folders, e.g.:
#   <prefix>/orders.parquet                -> table orders
#   <prefix>/customers/*.parquet           -> table customers
#   <prefix>/sales/customers/*.parquet     -> schema sales, table customers
#   <prefix>/hr/employees/year=2024/*.parq -> schema hr, table employees
S3_BUCKET=lakehouse
S3_PREFIX=
# Anonymous read of a public bucket (no access/secret keys needed):
# S3_ANONYMOUS=false
# Force https when S3_ENDPOINT_URL has no scheme:
# S3_USE_SSL=false
# --- Iceberg backend (only used when SQLHANDLER_BACKEND=iceberg) ---
# Read Apache Iceberg tables through a catalog; the data files live in your
# object store (or locally). Two catalog types are supported:
#   ICEBERG_CATALOG_TYPE=rest   - Iceberg REST catalog (default; e.g. Dremio,
#                                 Nessie, Amazon S3 Tables)
#   ICEBERG_CATALOG_TYPE=sql    - SQL catalog (SQLite/Postgres), handy for dev
ICEBERG_CATALOG_TYPE=rest
ICEBERG_CATALOG_URI=http://rest-catalog:8181
# Optional bearer token for the REST catalog:
# ICEBERG_CATALOG_TOKEN=
# Catalog name (SQL catalogs partition their metadata by this name; writers
# and readers must agree):
# ICEBERG_CATALOG_NAME=sqlhandler
# Optional warehouse root / namespace filter:
# ICEBERG_WAREHOUSE=
# ICEBERG_NAMESPACE=
# The Parquet data files are read from object storage using the same S3_*
# variables as the s3 backend (S3_ENDPOINT_URL / S3_REGION / S3_ACCESS_KEY /
# S3_SECRET_KEY); leave them unset when the warehouse is on a local disk.
