+/**
+ * Test whether one Assistant block renders anything the user can see.
+ *
+ * SINGLE SOURCE OF TRUTH. The streaming reducer (assistant.ts) and the turn
+ * fold's anchor (turn-process.ts) ask the same question, and after r4 they
+ * answered it differently for display-only relayed calls: the message body
+ * rendered the card while the fold counted the step as content-free, so a
+ * relayed card could settle into a different region from the narration around
+ * it. Both passes now call this.
+ *
+ * A RESULT-LESS tool-call head is not visible here: it renders as a tool row
+ * through the tool nodes, not in the message body. A result-bearing one is the
+ * r4 display-only relayed call and renders inline.
+ * @param block - Assistant content block, or undefined for a sparse slot.
+ * @returns whether the block renders in the message body.
+ */
+export function isVisibleAssistantBlock(block: AssistantBlock | undefined): boolean {
+  if (block === undefined) return false
+  if (block.kind === 'tool-call') return block.result !== undefined
+  if (block.kind === 'text' || block.kind === 'reasoning') return block.text.trim() !== ''
+  return true
+}
 
