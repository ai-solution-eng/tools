--- /dev/null
+++ b/packages/client/ui-chat/tests/assistant-visibility.client.spec.ts
@@ -0,0 +1,54 @@
+/** Block visibility parity: the message body and the turn fold share one predicate. */
+import { describe, expect, it } from 'vitest'
+import type { AssistantBlock } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import {
+  hasAssistantReplyContent, isVisibleAssistantBlock,
+} from '../src/client/contract/assistant-content.ts'
+
+const relayCard: AssistantBlock = {
+  kind: 'tool-call',
+  callId: 'relay-1',
+  name: 'logsearch__search_logs',
+  argsRaw: '{"q":"gpu"}',
+  result: '\n→ ok (175ms)\n{"hits":1}\n',
+  resultOk: true,
+}
+
+const pendingCall: AssistantBlock = {
+  kind: 'tool-call',
+  callId: 'call-1',
+  name: 'bash',
+  argsRaw: '{"cmd":"ls"}',
+}
+
+describe('isVisibleAssistantBlock', () => {
+  it('renders a display-only relayed call inline', () => {
+    expect(isVisibleAssistantBlock(relayCard)).toBe(true)
+  })
+
+  it('hides a result-less tool-call head, which renders as a tool row', () => {
+    expect(isVisibleAssistantBlock(pendingCall)).toBe(false)
+  })
+
+  it('hides empty text and reasoning and keeps non-empty', () => {
+    expect(isVisibleAssistantBlock({ kind: 'text', text: '   ' })).toBe(false)
+    expect(isVisibleAssistantBlock({ kind: 'reasoning', text: '' })).toBe(false)
+    expect(isVisibleAssistantBlock({ kind: 'text', text: 'done' })).toBe(true)
+    expect(isVisibleAssistantBlock({ kind: 'reasoning', text: 'thinking' })).toBe(true)
+  })
+
+  it('hides a sparse slot', () => {
+    expect(isVisibleAssistantBlock(undefined)).toBe(false)
+  })
+})
+
+describe('hasAssistantReplyContent', () => {
+  // Deliberate asymmetry, pinned so it is not "fixed" by accident: a relayed
+  // card is VISIBLE but is not a prose reply. latestAnswer() uses this to
+  // decide where the answer region starts, so a relay-only step must not claim
+  // it - only the visibility predicate is shared.
+  it('still excludes tool-call blocks, including relayed cards', () => {
+    expect(hasAssistantReplyContent([relayCard])).toBe(false)
+    expect(hasAssistantReplyContent([relayCard, { kind: 'text', text: 'done' }])).toBe(true)
+  })
+})
